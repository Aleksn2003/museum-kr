# Copy to .env and replace every CHANGE_ME value with a long random secret.
DB_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
ADMIN_PASSWORD=CHANGE_ME
APP_DEBUG=false
APP_TIMEZONE=Asia/Yakutsk
WEB_PORT=8080
# Existing installations can keep their old database volume by using its name.
DB_VOLUME_NAME=museum_pgdata
# Optional VK import. Rotate any previously published VK token first.
VK_SYNC_KEY=
VK_ACCESS_TOKEN=
VK_GROUP_ID=238549299
